# Copy to .env and fill in the three secrets below before the first start.
# Generate each one with: openssl rand -hex 32
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=
# Used once to create the first superadmin, who must change it at first sign-in.
SUPERADMIN_PASSWORD=

DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
HERALD_SITE_URL=http://localhost:8000
HERALD_PORT=8000

POSTGRES_DB=herald
POSTGRES_USER=herald
SUPERADMIN_EMAIL=admin@herald.local

# HTTPS: leave off for plain HTTP. Behind an HTTPS reverse proxy, see "Running behind HTTPS" in the README.
DJANGO_SECURE_PROXY_SSL_HEADER=0
DJANGO_SESSION_COOKIE_SECURE=0
DJANGO_CSRF_COOKIE_SECURE=0
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=0
DJANGO_SECURE_HSTS_PRELOAD=0

# Initial SMTP settings (only used if Settings > Email has never been saved)
HERALD_SMTP_HOST=mailpit
HERALD_SMTP_PORT=1025
HERALD_SMTP_SECURITY=none
HERALD_SMTP_SENDER=herald@herald.local
