# Copy to .env and adjust. Every value has a default in docker-compose.yml.
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
HERALD_SITE_URL=http://localhost:8000
HERALD_PORT=8000

POSTGRES_DB=herald
POSTGRES_USER=herald
POSTGRES_PASSWORD=herald

# Superadmin created on first start. You must change the password at first login.
SUPERADMIN_EMAIL=admin@herald.local
SUPERADMIN_PASSWORD=ChangeMe!2026

# Initial SMTP settings (only used if Settings > Email has never been saved)
HERALD_SMTP_HOST=mailpit
HERALD_SMTP_PORT=1025
HERALD_SMTP_SECURITY=none
HERALD_SMTP_SENDER=herald@herald.local
